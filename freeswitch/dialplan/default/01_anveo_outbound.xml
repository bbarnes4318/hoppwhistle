<include>
  <!--
    Anveo Direct Outbound Routing
    Default route for all US outbound traffic.
    Includes STIR/SHAKEN P-Attestation-Indicator header for certificate signing.
  -->
  <extension name="anveo_outbound_us">
    <condition field="destination_number" expression="^1?(\d{10})$">
      <!-- Set STIR/SHAKEN attestation header - triggers Anveo to sign with our cert -->
      <action application="set" data="sip_h_P-Attestation-Indicator=A"/>
      <action application="set" data="effective_caller_id_number=${caller_id_number}"/>
      <action application="set" data="effective_caller_id_name=${caller_id_name}"/>
      <action application="log" data="INFO Routing to Anveo Direct: +1$1"/>
      <action application="bridge" data="sofia/gateway/anveo/1$1"/>
    </condition>
  </extension>
</include>
