; ---------------------------------------------------------------------------
; [from-fractel] — inbound context for the dograh-asterisk container.
;
; Reference copy of the context that must exist in
;   /opt/dograh-asterisk/etc/extensions.conf
; on hopwhistle-prod-ash (178.156.223.97), bind-mounted into `dograh-asterisk`.
;
; This file is NOT loaded from the repo. It is the source of truth for review;
; apply it by replacing the [from-fractel] context in the file on the box, then
;   docker exec dograh-asterisk asterisk -rx "dialplan reload"
; Do NOT restart the container — the Stasis app `dograh` is live and a restart
; drops the ARI websocket. The file on the box also carries [globals] and
; [dograh-outbound]; leave both alone.
;
; WHY: Dograh's inbound lookup calls normalize_telephony_address() with no
; country hint, so a bare 10-digit DNIS normalizes to +<NPA as country code>
; and never matches a stored +1XXXXXXXXXX row:
;     +19138999080 -> +19138999080   match
;      19138999080 -> +19138999080   match
;       9138999080 -> +9138999080    NO match  ("913" eaten as country code)
; Every format is therefore folded to 11-digit 1NXXNXXXXXX before Stasis sees
; it, so `channel["dialplan"]["exten"]` is always normalizable to E.164.
;
; The trailing _X. fallback is deliberate and is NOT in the original spec for
; this change. Asterisk picks the most specific matching pattern, so the three
; patterns above it still win for every format they cover; _X. only catches
; what they do not. Without it, a DNIS in an unanticipated shape (7-digit,
; international, 11 digits not starting with 1) would stop matching any
; extension at all and be rejected by Asterisk — where today it reaches Stasis
; and Dograh logs a diagnosable "no matching phone number". No inbound INVITE
; has ever been observed on this trunk, so the delivered DNIS format is still
; unverified; dropping the catch-all before seeing one would risk trading a
; legible failure for a silent one.
; ---------------------------------------------------------------------------

[from-fractel]
; 10-digit -> prepend 1 and re-enter
exten => _NXXNXXXXXX,1,Goto(from-fractel,1${EXTEN},1)

; 11-digit NANP -> Stasis
exten => _1NXXNXXXXXX,1,NoOp(Inbound from FracTEL to ${EXTEN})
 same => n,Stasis(dograh)
 same => n,Hangup()

; +E.164 or punctuated -> strip to digits, re-enter above
exten => _+X.,1,Set(E=${FILTER(0-9,${EXTEN})})
 same => n,Goto(from-fractel,${E},1)

; fallback: anything else still reaches Stasis, exactly as before this change
exten => _X.,1,NoOp(Inbound from FracTEL to ${EXTEN} [unnormalized])
 same => n,Stasis(dograh)
 same => n,Hangup()
