{
  "name": "@hopwhistle/dialer-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hoppwhistle Dialer V2 — predictive dialing control plane (feature-gated, off by default)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "sim": "tsx src/sim/cli.ts"
  },
  "dependencies": {
    "@hopwhistle/shared": "workspace:*",
    "pino": "^8.17.2",
    "zod": "^3.22.4",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
