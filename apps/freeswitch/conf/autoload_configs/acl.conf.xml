<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <!-- Anveo Direct Signaling IPs -->
    <list name="anveo_direct" default="deny">
      <node type="allow" cidr="169.48.232.158/32"/>
      <node type="allow" cidr="204.216.109.55/32"/>
      <node type="allow" cidr="176.9.39.206/32"/>
      <node type="allow" cidr="72.9.149.25/32"/>
    </list>
    <list name="domains" default="deny">
      <!-- Allow Docker Network -->
      <node type="allow" cidr="172.18.0.0/16"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
      <node type="allow" cidr="10.0.0.0/8"/>
      <!-- Allow Localhost -->
      <node type="allow" cidr="127.0.0.1/32"/>
      <!-- Allow Public Internet for WebRTC -->
      <node type="allow" cidr="0.0.0.0/0"/>
    </list>
    <!-- Vapi SIP Source IPs - strictly enforced for Vapi integration -->
    <!-- These include SIP signaling IPs and Jambonz media server IPs -->
    <list name="vapi_sip_sources" default="deny">
      <!-- Vapi SIP signaling servers -->
      <node type="allow" cidr="44.229.228.186/32"/>
      <node type="allow" cidr="44.238.177.138/32"/>
      <!-- Jambonz media servers (seen in SDP: 34.223.48.167) -->
      <node type="allow" cidr="34.223.48.0/20"/>
      <!-- Additional AWS us-west-2 range for Vapi -->
      <node type="allow" cidr="44.229.0.0/16"/>
      <node type="allow" cidr="44.238.0.0/16"/>
    </list>
    <!-- BulkVS SIP Source IPs — required for inbound signaling from BulkVS -->
    <list name="bulkvs_sip_sources" default="deny">
      <node type="allow" cidr="162.249.171.0/24"/>
      <node type="allow" cidr="76.8.29.0/24"/>
      <node type="allow" cidr="142.171.206.0/24"/>
      <node type="allow" cidr="199.255.157.0/24"/>
      <node type="allow" cidr="69.12.88.0/24"/>
    </list>
  </network-lists>
</configuration>
