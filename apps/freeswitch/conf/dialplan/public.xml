<include>
  <context name="public">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Dynamic Inbound DID Routing
         Any inbound call arriving on the public/external interface is handled
         by the Lua routing script, which validates the DID with the database.
         ═══════════════════════════════════════════════════════════════════════ -->
    <extension name="inbound-dynamic-route">
      <condition field="destination_number" expression="^\+?1?([2-9]\d{9})$">
        <action application="log" data="INFO [PUBLIC] Dynamic inbound routing for ${destination_number} from ${caller_id_number}"/>
        <action application="set" data="domain_name=$${domain}"/>
        <action application="lua" data="inbound_route.lua"/>
      </condition>
    </extension>

    <!-- Default: reject unknown public destinations -->
    <extension name="unmatched-inbound">
      <condition field="destination_number" expression="^.+$">
        <action application="log" data="WARNING [PUBLIC] Unmatched public inbound destination: ${destination_number} from ${caller_id_number}"/>
        <action application="hangup" data="NO_ROUTE_DESTINATION"/>
      </condition>
    </extension>

  </context>
</include>
