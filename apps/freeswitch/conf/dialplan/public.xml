<include>
  <context name="public">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Dynamic Inbound DID Routing (Ringba-style)

         Any inbound call to a 10/11-digit number that isn't matched by a
         hardcoded extension below will be handled by the Lua routing script.
         The script calls the API to look up the destination, starts recording,
         bridges to the buyer's phone, and posts CDR on hangup.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Hardcoded: Call Center DID (281-699-1120) → WebRTC Agent -->
    <extension name="inbound-call-center">
      <condition field="destination_number" expression="^(\+?1?2816991120)$">
        <action application="log" data="INFO [PUBLIC] Inbound call to BulkVS DID 281-699-1120 from ${caller_id_number}"/>
        <action application="set" data="domain_name=3.214.60.13"/>
        <action application="set" data="call_direction=inbound"/>
        <action application="ring_ready"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=false"/>
        <!-- Codec negotiation: BulkVS PCMU/PCMA <-> WebRTC OPUS -->
        <action application="set" data="inbound_codec_negotiation=generous"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA,OPUS,G722"/>
        <action application="set" data="bypass_media=false"/>
        <action application="set" data="ringback=%(2000,4000,440,480)"/>
        <action application="set" data="instant_ringback=true"/>
        <action application="set" data="call_timeout=120"/>
        <!-- Bridge to registered WebRTC agent at extension 1000 -->
        <action application="bridge" data="${sofia_contact(internal/1000@3.214.60.13)}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- Legacy: keep old Anveo DID just in case -->
    <extension name="inbound-legacy-anveo">
      <condition field="destination_number" expression="^(\+?1?8652809894)$">
        <action application="log" data="INFO [PUBLIC] Legacy Anveo DID - routing to agent"/>
        <action application="set" data="domain_name=3.214.60.13"/>
        <action application="set" data="call_direction=inbound"/>
        <action application="ring_ready"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="inbound_codec_negotiation=generous"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA,OPUS,G722"/>
        <action application="set" data="bypass_media=false"/>
        <action application="set" data="ringback=%(2000,4000,440,480)"/>
        <action application="set" data="call_timeout=120"/>
        <action application="bridge" data="${sofia_contact(internal/1000@3.214.60.13)}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Dynamic Routing via Lua — ALL OTHER INBOUND DIDs
         
         This catches any 10-digit or 11-digit (1+10) inbound number that 
         wasn't matched above. The Lua script does an HTTP lookup to find
         the buyer destination, records the call, and bridges.
         ═══════════════════════════════════════════════════════════════════════ -->
    <extension name="inbound-dynamic-route">
      <condition field="destination_number" expression="^(\+?1?[2-9]\d{9})$">
        <action application="log" data="INFO [PUBLIC] Dynamic inbound routing for ${destination_number} from ${caller_id_number}"/>
        <action application="set" data="domain_name=3.214.60.13"/>
        <action application="lua" data="inbound_route.lua"/>
      </condition>
    </extension>

    <!-- Default: reject unknown inbound -->
    <extension name="unmatched-inbound">
      <condition field="destination_number" expression="^.+$">
        <action application="log" data="WARNING [PUBLIC] Unmatched inbound: ${destination_number} from ${caller_id_number}"/>
        <action application="hangup" data="NO_ROUTE_DESTINATION"/>
      </condition>
    </extension>

  </context>
</include>
