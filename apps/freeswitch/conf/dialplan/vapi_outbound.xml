<include>
  <!--
    Vapi Outbound Context — Per-Carrier Routing and Signing
    =====================================================
    Each carrier signs ONLY its own calls:
    - BulkVS:     bridge to sofia/gateway/bulkvs (no local signing — BulkVS handles STIR/SHAKEN)
    - DIDCentral: local_shaken.lua signs → bridge to sofia/gateway/didcentral
    - FracTEL:    local_shaken.lua signs → bridge to sofia/gateway/fractel*
    - SignalWire:  NO SIGNING — traffic goes Vapi → SignalWire direct (never hits FS)

    Carrier is determined by channel variable X-Carrier (set by Vapi/dialer).
    If X-Carrier is not set, defaults to fractel.
  -->
  <context name="vapi_outbound">

    <!-- Rate limiting for all Vapi calls -->
    <extension name="vapi-rate-limit" continue="true">
      <condition field="destination_number" expression="^.*$">
        <action application="limit" data="hash vapi ${destination_number} 10 !CALL_REJECTED"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- DEFAULT CARRIER: FracTEL -->
    <!-- Routes to the FracTEL gateways when X-Carrier is empty/not set. -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-default-fractel">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^$" break="never">
        <action application="log" data="INFO [VAPI] FracTEL (default) outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=fractel"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <!-- Validate caller ID via internal authenticated API -->
        <action application="unset" data="curl_response_code"/>
        <action application="unset" data="curl_response_data"/>
        <action application="unset" data="resolved_cid"/>
        <action application="curl" data="http://api:3001/api/v1/freeswitch/validate-caller-id?callId=${sip_h_X-Hopwhistle-Call-Id}&amp;signedContext=${sip_h_X-Hopwhistle-Signed-Context}&amp;destination=${destination_number}&amp;channelUuid=${uuid} append_headers X-Internal-API-Key:${env(INTERNAL_API_SECRET)} connect-timeout 3 timeout 5 get"/>
        <action application="set" data="resolved_cid=${regex(${curl_response_data}|&quot;callerId&quot;:&quot;(\d{11})&quot;|%1)}" inline="true"/>
      </condition>

      <!-- Fail closed if HTTP code is not 200 or caller ID invalid -->
      <condition field="${curl_response_code}" expression="^(?!200$).*$" break="never">
        <action application="log" data="ERR [VAPI] Caller ID API validation failed with HTTP status ${curl_response_code}. Failing closed."/>
        <action application="hangup" data="MANDATORY_CALLER_ID_MISSING"/>
      </condition>

      <!-- Valid caller ID: bridge across all 6 FracTEL gateways -->
      <condition field="${resolved_cid}" expression="^(1\d{10})$">
        <action application="set" data="effective_caller_id_number=${resolved_cid}" inline="true"/>
        <action application="set" data="origination_caller_id_number=${resolved_cid}" inline="true"/>
        <action application="set" data="sip_from_user=${resolved_cid}" inline="true"/>

        <!-- Bridge to FracTEL — load-balanced across all 6 SBCs -->
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC,origination_caller_id_number=${resolved_cid},sip_from_user=${resolved_cid}}sofia/gateway/fractel1/1${vapi_dest}|sofia/gateway/fractel2/1${vapi_dest}|sofia/gateway/fractel3/1${vapi_dest}|sofia/gateway/fractel4/1${vapi_dest}|sofia/gateway/fractel5/1${vapi_dest}|sofia/gateway/fractel6/1${vapi_dest}"/>
      </condition>

      <!-- Fail closed if caller ID is missing or invalid -->
      <condition field="${resolved_cid}" expression="^(?!1\d{10}$).*$">
        <action application="log" data="ERR [VAPI] Missing/unauthorized caller ID. Failing closed."/>
        <action application="hangup" data="MANDATORY_CALLER_ID_MISSING"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: BulkVS (explicit only) -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-bulkvs">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^bulkvs$" break="never">
        <action application="log" data="INFO [VAPI] BulkVS outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=bulkvs"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/bulkvs/1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: DIDCentral -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-didcentral">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^didcentral$" break="never">
        <action application="log" data="INFO [VAPI] DIDCentral outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=didcentral"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/didcentral/1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: FracTEL (explicit X-Carrier=fractel) -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-fractel">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^fractel$" break="never">
        <action application="log" data="INFO [VAPI] FracTEL outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=fractel"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <!-- Validate caller ID via internal authenticated API -->
        <action application="unset" data="curl_response_code"/>
        <action application="unset" data="curl_response_data"/>
        <action application="unset" data="resolved_cid"/>
        <action application="curl" data="http://api:3001/api/v1/freeswitch/validate-caller-id?callId=${sip_h_X-Hopwhistle-Call-Id}&amp;signedContext=${sip_h_X-Hopwhistle-Signed-Context}&amp;destination=${destination_number}&amp;channelUuid=${uuid} append_headers X-Internal-API-Key:${env(INTERNAL_API_SECRET)} connect-timeout 3 timeout 5 get"/>
        <action application="set" data="resolved_cid=${regex(${curl_response_data}|&quot;callerId&quot;:&quot;(\d{11})&quot;|%1)}" inline="true"/>
      </condition>

      <!-- Fail closed if HTTP code is not 200 or caller ID invalid -->
      <condition field="${curl_response_code}" expression="^(?!200$).*$" break="never">
        <action application="log" data="ERR [VAPI] Caller ID API validation failed with HTTP status ${curl_response_code}. Failing closed."/>
        <action application="hangup" data="MANDATORY_CALLER_ID_MISSING"/>
      </condition>

      <!-- Valid caller ID: bridge across all 6 FracTEL gateways -->
      <condition field="${resolved_cid}" expression="^(1\d{10})$">
        <action application="set" data="effective_caller_id_number=${resolved_cid}" inline="true"/>
        <action application="set" data="origination_caller_id_number=${resolved_cid}" inline="true"/>
        <action application="set" data="sip_from_user=${resolved_cid}" inline="true"/>

        <!-- Bridge to FracTEL — load-balanced across all 6 SBCs -->
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC,origination_caller_id_number=${resolved_cid},sip_from_user=${resolved_cid}}sofia/gateway/fractel1/1${vapi_dest}|sofia/gateway/fractel2/1${vapi_dest}|sofia/gateway/fractel3/1${vapi_dest}|sofia/gateway/fractel4/1${vapi_dest}|sofia/gateway/fractel5/1${vapi_dest}|sofia/gateway/fractel6/1${vapi_dest}"/>
      </condition>

      <!-- Fail closed if caller ID is missing or invalid -->
      <condition field="${resolved_cid}" expression="^(?!1\d{10}$).*$">
        <action application="log" data="ERR [VAPI] Missing/unauthorized caller ID. Failing closed."/>
        <action application="hangup" data="MANDATORY_CALLER_ID_MISSING"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: SignalWire -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-signalwire">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^signalwire$" break="never">
        <action application="log" data="INFO [VAPI] SignalWire outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=signalwire"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/signalwire/+1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- Vapi internal routing IDs (11+ digit strings) — route through FracTEL with caller ID validation -->
    <extension name="vapi-outbound-routing-id">
      <condition field="destination_number" expression="^(\d{11,})$">
        <action application="log" data="INFO [VAPI] Routing ID call to $1"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Call-Source=vapi_profile"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <!-- Validate caller ID hierarchy for routing ID calls -->
        <action application="unset" data="curl_response_code"/>
        <action application="unset" data="curl_response_data"/>
        <action application="unset" data="resolved_cid"/>
        <action application="curl" data="http://api:3001/api/v1/freeswitch/validate-caller-id?callId=${sip_h_X-Hopwhistle-Call-Id}&amp;signedContext=${sip_h_X-Hopwhistle-Signed-Context}&amp;destination=${destination_number}&amp;channelUuid=${uuid} append_headers X-Internal-API-Key:${env(INTERNAL_API_SECRET)} connect-timeout 3 timeout 5 get"/>
        <action application="set" data="resolved_cid=${regex(${curl_response_data}|&quot;callerId&quot;:&quot;(\d{11})&quot;|%1)}" inline="true"/>
      </condition>

      <!-- Fail closed if HTTP code is not 200 or caller ID invalid -->
      <condition field="${curl_response_code}" expression="^(?!200$).*$" break="never">
        <action application="log" data="ERR [VAPI] Caller ID API validation failed with HTTP status ${curl_response_code}. Failing closed."/>
        <action application="hangup" data="MANDATORY_CALLER_ID_MISSING"/>
      </condition>

      <!-- Valid caller ID: bridge across all 6 FracTEL gateways -->
      <condition field="${resolved_cid}" expression="^(1\d{10})$">
        <action application="set" data="effective_caller_id_number=${resolved_cid}" inline="true"/>
        <action application="set" data="origination_caller_id_number=${resolved_cid}" inline="true"/>
        <action application="set" data="sip_from_user=${resolved_cid}" inline="true"/>

        <!-- Route through FracTEL load-balanced across all 6 SBCs -->
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC,origination_caller_id_number=${resolved_cid},sip_from_user=${resolved_cid}}sofia/gateway/fractel1/$1|sofia/gateway/fractel2/$1|sofia/gateway/fractel3/$1|sofia/gateway/fractel4/$1|sofia/gateway/fractel5/$1|sofia/gateway/fractel6/$1"/>
      </condition>

      <!-- Fail closed if caller ID is missing or invalid -->
      <condition field="${resolved_cid}" expression="^(?!1\d{10}$).*$">
        <action application="log" data="ERR [VAPI] Missing/unauthorized caller ID for routing ID. Failing closed."/>
        <action application="hangup" data="MANDATORY_CALLER_ID_MISSING"/>
      </condition>
    </extension>

    <!-- Fallback — reject unmatched destinations -->
    <extension name="vapi-unmatched">
      <condition field="destination_number" expression="^.*$">
        <action application="log" data="WARNING [VAPI] Unmatched destination: ${destination_number}"/>
        <action application="hangup" data="NO_ROUTE_DESTINATION"/>
      </condition>
    </extension>

  </context>
</include>
