<include>
  <!--
    Vapi Outbound Context — Per-Carrier Routing & Signing
    =====================================================
    Each carrier signs ONLY its own calls:
    - BulkVS:     bridge to sofia/gateway/bulkvs (no local signing — BulkVS handles STIR/SHAKEN)
    - DIDCentral: local_shaken.lua signs → bridge to sofia/gateway/didcentral
    - FracTEL:    local_shaken.lua signs → bridge to sofia/gateway/fractel*
    - SignalWire:  NO SIGNING — traffic goes Vapi → SignalWire direct (never hits FS)

    Carrier is determined by channel variable X-Carrier (set by Vapi/dialer).
    If X-Carrier is not set, defaults to bulkvs.

    IMPORTANT: In multi-condition extensions, $1 refers to the LAST condition's
    capture group. We use the first condition to set ${vapi_dest} explicitly so
    the phone number is available in bridge actions regardless of condition nesting.
  -->
  <context name="vapi_outbound">

    <!-- Rate limiting for all Vapi calls -->
    <extension name="vapi-rate-limit" continue="true">
      <condition field="destination_number" expression="^.*$">
        <action application="limit" data="hash vapi ${destination_number} 10 !CALL_REJECTED"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- DEFAULT CARRIER: SignalWire -->
    <!-- Routes to SignalWire gateway when X-Carrier is empty or not set -->
    <!-- SignalWire handles STIR/SHAKEN internally — no local signing -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-default-signalwire">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^(signalwire)?$" break="never">
        <action application="log" data="INFO [VAPI] SignalWire (default) outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=signalwire"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <!-- Force G.711 for SignalWire PSTN -->
        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <!-- Force caller ID to SignalWire DID on B-leg -->
        <action application="set" data="effective_caller_id_number=18652679650"/>
        <action application="set" data="origination_caller_id_number=18652679650"/>

        <!-- Bridge to SignalWire — origination CID must be in {} for B-leg -->
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC,origination_caller_id_number=18652679650,sip_from_user=18652679650}sofia/gateway/signalwire/+1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: BulkVS (explicit only) -->
    <!-- Only used when X-Carrier header is explicitly set to "bulkvs" -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-bulkvs">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^bulkvs$" break="never">
        <action application="log" data="INFO [VAPI] BulkVS outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=bulkvs"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/bulkvs/1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: DIDCentral -->
    <!-- Signs with local STIR/SHAKEN (ES256), routes to DIDCentral gateway -->
    <!-- DIDCentral requires pre-tokenized calls with Identity header -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-didcentral">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^didcentral$" break="never">
        <action application="log" data="INFO [VAPI] DIDCentral outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=didcentral"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <!-- DIDCentral STIR/SHAKEN signing (local ES256 A-attestation) -->
        <action application="lua" data="local_shaken.lua"/>

        <!-- Bridge to DIDCentral ONLY -->
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/didcentral/1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: FracTEL -->
    <!-- Signs with local STIR/SHAKEN (ES256), load-balances across 6 SBCs -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-fractel">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^fractel$" break="never">
        <action application="log" data="INFO [VAPI] FracTEL outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=fractel"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <!-- FracTEL STIR/SHAKEN signing (local ES256 A-attestation) -->
        <action application="lua" data="local_shaken.lua"/>
        <action application="set" data="sip_h_X-Attestation-Level=A"/>

        <!-- Bridge to FracTEL — load-balanced across all 6 SBCs -->
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/fractel1/1${vapi_dest}|sofia/gateway/fractel2/1${vapi_dest}|sofia/gateway/fractel3/1${vapi_dest}|sofia/gateway/fractel4/1${vapi_dest}|sofia/gateway/fractel5/1${vapi_dest}|sofia/gateway/fractel6/1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- ================================================================ -->
    <!-- CARRIER: SignalWire -->
    <!-- No STIR/SHAKEN signing — SignalWire handles attestation internally -->
    <!-- Routes through the signalwire gateway defined in external/ -->
    <!-- ================================================================ -->
    <extension name="vapi-outbound-signalwire">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="set" data="vapi_dest=$1" inline="true"/>
      </condition>
      <condition field="${sip_h_X-Carrier}" expression="^signalwire$" break="never">
        <action application="log" data="INFO [VAPI] SignalWire outbound to 1${vapi_dest}"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Carrier=signalwire"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <!-- Force G.711 for SignalWire PSTN termination -->
        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <!-- Bridge to SignalWire gateway — no signing needed -->
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/signalwire/+1${vapi_dest}"/>
      </condition>
    </extension>

    <!-- Vapi internal routing IDs (11+ digit strings) — route through default carrier -->
    <extension name="vapi-outbound-routing-id">
      <condition field="destination_number" expression="^(\d{11,})$">
        <action application="log" data="INFO [VAPI] Routing ID call to $1"/>

        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="sip_h_X-Provider=Vapi"/>
        <action application="set" data="sip_h_X-Call-Source=vapi_profile"/>

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="ignore_early_media=true"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>

        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>

        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC}sofia/gateway/bulkvs/$1"/>
      </condition>
    </extension>

    <!-- Fallback — reject unmatched destinations -->
    <extension name="vapi-unmatched">
      <condition field="destination_number" expression="^.*$">
        <action application="log" data="WARNING [VAPI] Unmatched destination: ${destination_number}"/>
        <action application="hangup" data="NO_ROUTE_DESTINATION"/>
      </condition>
    </extension>

  </context>
</include>
