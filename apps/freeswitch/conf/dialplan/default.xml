<include>
  <context name="default">

    <!-- Local extension calls (agent-to-agent, 4 digits starting with 1) -->
    <extension name="local-extension">
      <condition field="destination_number" expression="^(1[0-9]{3})$">
        <action application="log" data="INFO [DEFAULT] Local call to extension ${destination_number}"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="bypass_media=false"/>
        <action application="set" data="inbound_codec_negotiation=generous"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA,OPUS,G722"/>
        <action application="bridge" data="${sofia_contact(internal/${destination_number}@3.214.60.13)}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- Inbound from BulkVS DID (281-699-1120) arriving on port 5060 -->
    <!-- Bridge DIRECTLY to registered agent 1000 via sofia_contact (no loopback) -->
    <extension name="inbound-bulkvs-did">
      <condition field="destination_number" expression="^(\+?1?2816991120)$">
        <action application="log" data="INFO [DEFAULT] BulkVS inbound to DID 281-699-1120 from ${caller_id_number}"/>
        <action application="ring_ready"/>
        <action application="set" data="call_direction=inbound"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=false"/>
        <action application="set" data="bypass_media=false"/>
        <action application="set" data="inbound_codec_negotiation=generous"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA,OPUS,G722"/>
        <action application="set" data="ringback=%(2000,4000,440,480)"/>
        <action application="set" data="instant_ringback=true"/>
        <action application="set" data="call_timeout=120"/>
        <action application="bridge" data="${sofia_contact(internal/1000@3.214.60.13)}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- Outbound calls via BulkVS (NANP numbers only) -->
    <extension name="outbound-to-bulkvs">
      <condition field="destination_number" expression="^1?([2-9]\d{9})$">
        <action application="log" data="INFO [DEFAULT] Outbound call to ${destination_number} via BulkVS with X-Caller-ID=${sip_h_X-Caller-ID}"/>
        <action application="set" data="req_caller_id=${cond(${sip_h_X-Caller-ID} != '' ? ${sip_h_X-Caller-ID} : ${sip_h_x-caller-id})}"/>
        <action application="set" data="clean_caller_id=${cond(${req_caller_id} != '' ? ${req_caller_id} : 12816991120)}"/>
        <action application="set" data="effective_caller_id_number=+${clean_caller_id}"/>
        <action application="set" data="origination_caller_id_number=+${clean_caller_id}"/>
        <action application="set" data="effective_caller_id_name=Hopwhistle"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="bypass_media=false"/>
        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>
        
        <!-- Set and verify Hopwhistle Call ID -->
        <action application="set" data="hopwhistle_call_id=${cond(${sip_h_X-Hopwhistle-Call-Id} != '' ? ${sip_h_X-Hopwhistle-Call-Id} : ${sip_h_x-hopwhistle-call-id})}"/>
      </condition>
      <!-- Conditionally record if hopwhistle_call_id is set -->
      <condition field="${hopwhistle_call_id}" expression="^(.+)$" break="never">
        <action application="log" data="INFO [DEFAULT] Outbound call recording active for Call ID: ${hopwhistle_call_id}"/>
        <action application="set" data="hopwhistle_recording_path=/recordings/${hopwhistle_call_id}.wav"/>
        <action application="set" data="api_hangup_hook=bg_system /usr/share/freeswitch/scripts/upload-recording.sh ${hopwhistle_recording_path} ${hopwhistle_call_id}"/>
        <action application="record_session" data="${hopwhistle_recording_path}"/>
      </condition>
      <!-- Bridge outbound call -->
      <condition field="destination_number" expression="^1?([2-9]\d{9})$">
        <action application="bridge" data="sofia/gateway/bulkvs/1${destination_number}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- Catch-all: REJECT unknown destinations -->
    <extension name="catch-all-reject">
      <condition field="destination_number" expression="^.+$">
        <action application="log" data="WARNING [DEFAULT] Rejecting unknown dest=${destination_number} from ${caller_id_number}"/>
        <action application="hangup" data="CALL_REJECTED"/>
      </condition>
    </extension>

  </context>
</include>
