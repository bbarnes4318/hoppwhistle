<include>
  <context name="default">

    <!-- Local extension calls (agent-to-agent, 4 digits starting with 1) -->
    <extension name="local-extension">
      <condition field="destination_number" expression="^(1[0-9]{3})$">
        <action application="log" data="INFO [DEFAULT] Local call to extension ${destination_number}"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="bypass_media=false"/>
        <action application="set" data="inbound_codec_negotiation=generous"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA,OPUS,G722"/>
        <action application="bridge" data="${sofia_contact(internal/${destination_number}@$${domain})}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- Inbound from BulkVS DID (281-699-1120) arriving on port 5060 -->
    <!-- Bridge DIRECTLY to registered agent 1000 via sofia_contact (no loopback) -->
    <extension name="inbound-bulkvs-did">
      <condition field="destination_number" expression="^(\+?1?2816991120)$">
        <action application="log" data="INFO [DEFAULT] BulkVS inbound to DID 281-699-1120 from ${caller_id_number}"/>
        <action application="ring_ready"/>
        <action application="set" data="call_direction=inbound"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=false"/>
        <action application="set" data="bypass_media=false"/>
        <action application="set" data="inbound_codec_negotiation=generous"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA,OPUS,G722"/>
        <action application="set" data="ringback=%(2000,4000,440,480)"/>
        <action application="set" data="instant_ringback=true"/>
        <action application="set" data="call_timeout=120"/>
        <action application="bridge" data="${sofia_contact(internal/1000@$${domain})}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- Recording Smoke Test Extension -->
    <extension name="recording-smoke-test">
      <condition field="destination_number" expression="^(9999)$">
        <action application="log" data="INFO HOPWHISTLE RECORDING SMOKE TEST HIT"/>
        <action application="set" data="bypass_media=false" inline="true"/>
        <action application="set" data="proxy_media=false" inline="true"/>
        <action application="answer"/>
        <action application="record_session" data="/recordings/test.wav"/>
        <action application="playback" data="tone_stream://%(2000,4000,440,480);loops=3"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- Outbound calls via BulkVS (NANP numbers only) -->
    <extension name="outbound-to-bulkvs">
      <!-- Unavoidable top level logging + initialization. This must be the very first condition. -->
      <condition field="destination_number" expression="^\+?1?([2-9]\d{9})$">
        <!-- Force media through FreeSWITCH so RTP is captured -->
        <action application="set" data="bypass_media=false" inline="true"/>
        <action application="set" data="proxy_media=false" inline="true"/>
        <action application="set" data="bypass_media_after_bridge=false" inline="true"/>

        <!-- Send caller ID via P-Asserted-Identity header to the carrier -->
        <action application="export" data="nolocal:sip_cid_type=pid" inline="true"/>

        <!-- Extract X-Caller-ID (mixed or lowercase) -->
        <action application="set" data="req_caller_id=${sip_h_X-Caller-ID}" inline="true"/>
        <action application="set" data="hopwhistle_call_id=${sip_h_X-Hopwhistle-Call-Id}" inline="true"/>
        <action application="set" data="domain_name=$${domain}" inline="true"/>
      </condition>

      <!-- If req_caller_id is empty, fallback to lowercase -->
      <condition field="${req_caller_id}" expression="^$" break="never">
        <action application="set" data="req_caller_id=${sip_h_x-caller-id}" inline="true"/>
      </condition>
      <!-- If req_caller_id is still empty, set default -->
      <condition field="${req_caller_id}" expression="^$" break="never">
        <action application="set" data="req_caller_id=$${FRACTEL_DEFAULT_CALLER_ID}" inline="true"/>
      </condition>

      <!-- If req_caller_id is a demo/fake 555 number, rewrite it to our verified outbound caller ID -->
      <condition field="${req_caller_id}" expression="^1?555" break="never">
        <action application="set" data="req_caller_id=$${outbound_caller_id}" inline="true"/>
      </condition>

      <!-- Clean req_caller_id to remove any leading + and ensure it starts with 1 -->
      <condition field="${req_caller_id}" expression="^\+?1?([2-9]\d{9})$" break="never">
        <action application="set" data="req_caller_id=1$1" inline="true"/>
      </condition>

      <!-- If hopwhistle_call_id is empty, fallback to lowercase -->
      <condition field="${hopwhistle_call_id}" expression="^$" break="never">
        <action application="set" data="hopwhistle_call_id=${sip_h_x-hopwhistle-call-id}" inline="true"/>
      </condition>

      <!-- Now we log all details (including extracted variables) -->
      <condition field="destination_number" expression="^\+?1?([2-9]\d{9})$" break="never">
        <action application="log" data="INFO HOPWHISTLE OUTBOUND HIT uuid=${uuid} dest=${destination_number} clean_dest=$1 sip_call_id=${sip_call_id} header=${sip_h_X-Hopwhistle-Call-Id} lowercase=${sip_h_x-hopwhistle-call-id} hopwhistle_call_id=${hopwhistle_call_id} hopwhistle_recording_path=/recordings/${hopwhistle_call_id}.wav caller_id_number=${caller_id_number} effective_caller_id_number=${effective_caller_id_number}" inline="true"/>
      </condition>

      <!-- If hopwhistle_call_id is still empty: log a clear error and notify API recording-status failed -->
      <condition field="${hopwhistle_call_id}" expression="^$" break="never">
        <action application="log" data="ERR HOPWHISTLE OUTBOUND ERROR: Missing X-Hopwhistle-Call-Id header! Cannot record call."/>
        <!-- Notify API recording-status failed directly via bg_system / curl -->
        <action application="system" data="curl -s -X POST -H 'Content-Type: application/json' -H 'x-api-key: ${env(API_KEY)}' -d '{&quot;status&quot;: &quot;failed&quot;, &quot;error&quot;: &quot;Missing X-Hopwhistle-Call-Id header on FreeSWITCH channel&quot;}' http://api:3001/api/v1/calls/unknown/recording-status || true"/>
      </condition>

      <!-- Set caller ID variables for ALL outbound calls -->
      <condition field="destination_number" expression="^\+?1?([2-9]\d{9})$" break="never">
        <action application="set" data="clean_caller_id=${req_caller_id}" inline="true"/>
        <action application="set" data="effective_caller_id_number=${clean_caller_id}" inline="true"/>
        <action application="set" data="origination_caller_id_number=${clean_caller_id}" inline="true"/>
        <action application="set" data="sip_from_user=${clean_caller_id}" inline="true"/>
        <action application="set" data="sip_invite_from_uri=sip:${clean_caller_id}@$${domain}" inline="true"/>
        <action application="set" data="effective_caller_id_name=Hopwhistle" inline="true"/>
        <action application="set" data="origination_caller_id_name=Hopwhistle" inline="true"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <!-- Outbound carrier: FracTEL (STATIC/IP auth). The bridge below fails
             over across all 6 FracTEL outbound IPs (fractel1-6 gateways). -->
      </condition>

      <!-- If hopwhistle_call_id is NOT empty, apply details and start record_session before bridge -->
      <condition field="${hopwhistle_call_id}" expression="^(.+)$" break="never">
        <!-- Agent (A-leg) may use wideband so recordings capture HD agent audio.
             The PSTN (B-leg) stays G.711 for FracTEL — carrier leg is unchanged. -->
        <action application="set" data="absolute_codec_string=OPUS,G722,PCMU,PCMA"/>
        <action application="export" data="nolocal:absolute_codec_string=PCMU,PCMA"/>
        <action application="export" data="nolocal:dtmf_type=rfc2833"/>

        <!-- Record both parties on separate stereo channels at 16 kHz (agent left,
             caller right) instead of a muddy 8 kHz mono mix. -->
        <action application="set" data="RECORD_STEREO=true"/>
        <action application="set" data="RECORD_SAMPLE_RATE=16000"/>

        <!-- Set recording variables and start record_session -->
        <action application="set" data="hopwhistle_recording_path=/recordings/${hopwhistle_call_id}.wav" inline="true"/>
        <action application="log" data="INFO HOPWHISTLE RECORD_SESSION START path=/recordings/${hopwhistle_call_id}.wav" inline="true"/>
        <action application="set" data="api_hangup_hook=bg_system /usr/share/freeswitch/scripts/upload-recording.sh /recordings/${hopwhistle_call_id}.wav ${hopwhistle_call_id}"/>
        <action application="record_session" data="/recordings/${hopwhistle_call_id}.wav"/>
      </condition>

      <!-- Bridge outbound call -->
      <condition field="destination_number" expression="^\+?1?([2-9]\d{9})$">
        <!-- Save the clean 10-digit number to clean_dest -->
        <action application="set" data="clean_dest=$1" inline="true"/>
        <!-- Lookup via HTTP GET API using mod_curl -->
        <action application="set" data="lookup_response=${curl(http://api:3001/api/v1/freeswitch/lookup?did=%2b1$1)}" inline="true"/>
        <!-- Extract the destination extension if it's a 4-digit number -->
        <action application="set" data="local_ext=${regex(${lookup_response}|&quot;destination&quot;:&quot;(\d{4})&quot;|%1)}" inline="true"/>
        <action application="log" data="INFO [OUTBOUND-LOOKUP] response=${lookup_response} local_ext=${local_ext}"/>
      </condition>

      <!-- ================================================================
           Resolve the carrier waterfall for this call.

           The carrier used to be a literal fractel1..6 chain written into the
           bridge below. Six IPs, but one carrier: when FracTEL degraded there
           was nothing to fall back to, and changing it meant rebuilding this
           image. The API now answers with the configured waterfall for this
           call type, so an admin can reorder carriers in the settings UI and
           have it take effect on the next call.

           X-Hopwhistle-Route-Type distinguishes the softphone from the call
           center's manual and power-dialer paths; the API defaults to
           SOFTPHONE_MANUAL when it is absent.
           ================================================================ -->
      <condition field="destination_number" expression="^\+?1?([2-9]\d{9})$" break="never">
        <action application="set" data="hopwhistle_route_type=${sip_h_X-Hopwhistle-Route-Type}" inline="true"/>
      </condition>
      <condition field="${hopwhistle_route_type}" expression="^$" break="never">
        <action application="set" data="hopwhistle_route_type=${sip_h_x-hopwhistle-route-type}" inline="true"/>
      </condition>
      <condition field="destination_number" expression="^\+?1?([2-9]\d{9})$" break="never">
        <!-- Bounded so a slow or hung API cannot hold the caller in silence;
             the static chain below covers the timeout. -->
        <action application="set" data="curl_connect_timeout=2" inline="true"/>
        <action application="set" data="curl_timeout=4" inline="true"/>
        <action application="set" data="carrier_bridge=${curl(http://api:3001/api/v1/freeswitch/carrier-route?type=${hopwhistle_route_type}&amp;dest=$1&amp;cid=${clean_caller_id}&amp;cid_name=Hopwhistle)}" inline="true"/>
      </condition>

      <!-- If the API did not return a usable chain — down, timed out, or
           answered with an error body — fall back to the chain that was
           hardcoded here before. Routing must never be the reason a call
           fails to leave the building. -->
      <condition field="${carrier_bridge}" expression="sofia/gateway/" break="never">
        <anti-action application="log" data="WARNING [OUTBOUND-PSTN] carrier-route lookup returned no chain; using static FracTEL fallback"/>
        <anti-action application="set" data="carrier_bridge={sip_cid_type=pid,origination_caller_id_name=Hopwhistle,origination_caller_id_number=${clean_caller_id},sip_from_user=${clean_caller_id}}sofia/gateway/fractel1/1${clean_dest}|sofia/gateway/fractel2/1${clean_dest}|sofia/gateway/fractel3/1${clean_dest}|sofia/gateway/fractel4/1${clean_dest}|sofia/gateway/fractel5/1${clean_dest}|sofia/gateway/fractel6/1${clean_dest}" inline="true"/>
      </condition>

      <!-- If local extension is matched but unregistered, clear local_ext to fall back to PSTN -->
      <condition field="${local_ext}:${sofia_contact(internal/${local_ext}@$${domain})}" expression="^\d{4}:error" break="never">
        <action application="log" data="WARNING [OUTBOUND-LOCAL] Extension ${local_ext} is offline. Routing call via PSTN carrier gateways."/>
        <action application="set" data="local_ext=" inline="true"/>
      </condition>

      <!-- Route call locally to extension if matched, otherwise failover to PSTN gateways -->
      <condition field="${local_ext}" expression="^\d{4}$">
        <!-- Local routing -->
        <action application="log" data="INFO [OUTBOUND-LOCAL] Routing locally to extension ${local_ext}"/>
        <action application="bridge" data="${sofia_contact(internal/${local_ext}@$${domain})}"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
        
        <!-- PSTN routing (anti-action) — FracTEL trunk, failover across all 6 outbound IPs -->
        <anti-action application="log" data="INFO [OUTBOUND-PSTN] route=${hopwhistle_route_type} dest=1${clean_dest} cid=${clean_caller_id} bridge=${carrier_bridge}"/>
        <anti-action application="set" data="continue_on_fail=true"/>
        <anti-action application="set" data="fail_on_single_reject=false"/>
        <anti-action application="bridge" data="${carrier_bridge}"/>

        <!-- Reached only when the ENTIRE waterfall failed: continue_on_fail
             keeps execution going past a failed bridge, and hangup_after_bridge
             ends the call on a successful one. So arriving here means every
             gateway in the chain refused, and reporting them is what demotes a
             carrier that has stopped connecting calls.

             Deliberately NOT an api_hangup_hook: this extension already sets
             one, for upload-recording.sh, and api_hangup_hook holds a single
             value — a second `set` would silently replace it and stop every
             outbound recording from being uploaded. -->
        <anti-action application="log" data="ERR [OUTBOUND-PSTN] entire carrier waterfall failed for 1${clean_dest}: ${originate_disposition}"/>
        <anti-action application="set" data="carrier_report=${curl(http://api:3001/api/v1/freeswitch/carrier-result?chain=${carrier_bridge}&amp;cause=${originate_disposition}&amp;answered=false)}" inline="true"/>
        <anti-action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>

    <!-- Catch-all: REJECT unknown destinations -->
    <extension name="catch-all-reject">
      <condition field="destination_number" expression="^.+$">
        <action application="log" data="WARNING [DEFAULT] Rejecting unknown dest=${destination_number} from ${caller_id_number}"/>
        <action application="hangup" data="CALL_REJECTED"/>
      </condition>
    </extension>

  </context>
</include>
