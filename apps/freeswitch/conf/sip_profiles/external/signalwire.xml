<include>
  <!--
    SignalWire trunk.

    Credentials come from the environment via vars.xml. They were previously
    written inline here, which put a live SIP password in git history — rotate
    it in the SignalWire portal and set SIGNALWIRE_SIP_PASSWORD in .env.

    The domain defaults are the space this trunk has always pointed at, so only
    the password is strictly required to restore it.
  -->
  <gateway name="signalwire">
    <param name="realm" value="$${signalwire_domain}"/>
    <param name="proxy" value="$${signalwire_proxy}"/>
    <param name="username" value="$${signalwire_user}"/>
    <param name="password" value="$${signalwire_pass}"/>
    <param name="register" value="true"/>
    <param name="from-user" value="$${signalwire_user}"/>
    <param name="from-domain" value="$${signalwire_domain}"/>
    <param name="caller-id-in-from" value="true"/>
    <param name="extension" value="$${signalwire_user}"/>
    <param name="retry-seconds" value="30"/>
    <param name="expire-seconds" value="600"/>
    <param name="ping" value="25"/>
  </gateway>
</include>
