/// Audit record for each inbound lead submission + delivery attempt.
/// Preserves full lifecycle: raw → normalized → mapped → posted → response.
model InsuranceLeadSubmission {
  id              String            @id @default(uuid())
  tenantId        String
  insuranceLeadId String
  vertical        InsuranceVertical
  source          String?
  receivedAt      DateTime          @default(now())

  // Payload preservation
  rawPayload            Json // Original inbound JSON
  normalizedPayload     Json? // After normalization
  mappedOutboundPayload Json? // Final Ameriquote payload (secrets redacted)

  // Validation
  validationStatus InsuranceValidationStatus @default(INVALID)
  validationErrors Json? // Structured Zod errors

  // Posting
  postStatus InsurancePostStatus @default(PENDING)
  postMode   InsuranceLeadMode   @default(TEST)

  // Ameriquote response
  ameriquoteResponseRaw    String? // Raw response body
  ameriquoteResponseStatus String? // Matched | Unmatched | Error
  ameriquoteLeadId         String? // lead_id from matched response
  ameriquotePrice          String? // price from matched response
  ameriquoteErrorMessage   String? // error message if Error

  // Timing
  postedAt      DateTime?
  lastAttemptAt DateTime?
  attemptCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  insuranceLead InsuranceLead @relation(fields: [insuranceLeadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([insuranceLeadId])
  @@index([tenantId, vertical])
  @@index([tenantId, postStatus])
  @@index([tenantId, validationStatus])
  @@index([tenantId, postMode])
  @@index([receivedAt])
  @@map("insurance_lead_submissions")
}

model CampaignPublisher {
