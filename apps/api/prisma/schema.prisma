  costPerMinute Decimal  @default(0.25) @db.Decimal(10, 4) // Per-minute billing rate
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("vapi_templates")
}

model AICampaign {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  status      AICampaignStatus @default(DRAFT)

  // Template-driven configuration
  vertical       String // "ACA", "FINAL_EXPENSE"
  direction      String @default("OUTBOUND") // "OUTBOUND" | "INBOUND"
  carrier        String @default("bulkvs") // "bulkvs" | "signalwire"
  agencyName     String
  transferNumber String // E.164 format for live transfers
  filters        Json   @default("{}") // e.g. { "no_marketplace": true, "active_bank": true }

  // Vapi Integration (populated after assistant provisioning)
  vapiAssistantId   String? // Unique Vapi assistant ID for this campaign
  vapiPhoneNumberId String? // Vapi phone number ID (if BYOC configured)

  // Phone Number - MUST be from user's inventory
  phoneNumberId String
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id])

  // Calling Configuration
  maxConcurrent  Int @default(1) // Max simultaneous calls
  callsPerMinute Int @default(10) // Rate limit

  // Schedule (optional)
  scheduleEnabled Boolean   @default(false)
  scheduleStart   DateTime?
  scheduleEnd     DateTime?
  timezone        String    @default("America/New_York")

  // Relations
  contacts AICampaignContact[]
  calls    AICampaignCall[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@map("ai_campaigns")
}

enum AICampaignStatus {
  DRAFT // Being configured
  READY // Contacts uploaded, ready to run
  RUNNING // Actively making calls
  PAUSED // Manually paused or auto-paused (low funds)
  COMPLETED // All contacts processed
}

model AICampaignContact {
  id          String        @id @default(uuid())
  campaignId  String
  campaign    AICampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phoneNumber String // E.164 format
  firstName   String?
  lastName    String?
  metadata    Json? // Custom fields from CSV
  status      ContactStatus @default(PENDING)
  callId      String?       @unique // Link to AICampaignCall
  calledAt    DateTime?
  createdAt   DateTime      @default(now())

  calls AICampaignCall[] @relation("ContactCalls")

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([phoneNumber])
  @@map("ai_campaign_contacts")
}

enum ContactStatus {
  PENDING // Not yet called
  CALLING // Currently in progress
  COMPLETED // Call finished successfully
  FAILED // Call failed (network, etc)
  SKIPPED // Skipped (DNC, invalid number, etc)
  NO_ANSWER // No answer after attempts
}

model AICampaignCall {
  id         String            @id @default(uuid())
  campaignId String
  campaign   AICampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    AICampaignContact @relation("ContactCalls", fields: [contactId], references: [id], onDelete: Cascade)
  externalId String? // Vapi call ID (internal use only, never shown in UI)
  status     AICallStatus      @default(QUEUED)
  duration   Int? // Call duration in seconds
  outcome    String? // e.g., "answered", "voicemail", "busy"

  // Recording & Transcript
  recordingUrl String?
  transcript   String? @db.Text

  // AI Analysis (The "Juice" - structured data extraction)
  analysis   Json? // Full Vapi analysis object
  extraction Json? // Specific extracted fields (e.g., appointment_time, sentiment)

  // Billing (Refinement 2)
  cost     Decimal? @db.Decimal(10, 4) // Actual cost from Vapi
  billable Decimal? @db.Decimal(10, 4) // What we charge the user (with margin)

  // Timestamps
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([externalId])
  @@index([startedAt])
  @@map("ai_campaign_calls")
}

enum AICallStatus {
  QUEUED // Waiting to be dialed
  RINGING // Dial in progress
  IN_PROGRESS // Call connected
  COMPLETED // Call finished
  FAILED // Call failed
  NO_ANSWER // Not answered
  BUSY // Line busy
  VOICEMAIL // Went to voicemail
}

