// ============================================================================
// Industry Research (multi-provider forensic research pipeline)
// Additive, tenant-isolated. Gated behind INDUSTRY_RESEARCH_ENABLED. Touches no
// telephony/dialer/voice-AI zones.
// ============================================================================

model ResearchRun {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  researchBriefId String

  industry  String
  geography String
  mode      String // rapid_scan | full_due_diligence | forensic_max

  status String @default("queued") // queued|planning|running|waiting|completed|failed|canceled|timed_out|budget_exceeded

  // Canonical brief, resolved provider assignments and cost estimate (JSON)
  brief               Json
  providerAssignments Json
  costEstimate        Json

  // Live progress events + research plan (JSON)
  plan     Json?
  progress Json? // array of ProgressEvent

  // Budget & cost tracking
  maxBudgetUsd       Float @default(0)
  estimatedCostUsd   Float @default(0)
  accruedCostUsd     Float @default(0)

  // Outcome mirror (denormalized for list/search)
  verdict            String?
  overallScore       Int?
  insufficientEvidence Boolean @default(false)

  error String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stages  ResearchStage[]
  reports ResearchReport[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, industry])
  @@index([status])
  @@map("research_runs")
}

model ResearchStage {
  id    String @id @default(uuid())
  runId String

  stageKey String // normalize|plan|primary|independent|social|evidence|validation|contradictions|synthesis|verify|publish
  label    String
  role     String?
  provider String?
  model    String?

  status String @default("pending") // pending|running|completed|failed|skipped|canceled|fallback

  sourcesFound Int?
  searches     Int?
  costUsd      Float @default(0)
  usedFallback Boolean @default(false)

  // Raw provider output preserved for auditing (JSON)
  output Json?
  error  String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  run ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, stageKey])
  @@map("research_stages")
}

model ResearchReport {
  id       String @id @default(uuid())
  runId    String
  tenantId String

  version Int @default(1)

  verdict      String?
  overallScore Int?

  // Rendered markdown + validated structured report + evidence (JSON)
  markdown   String
  structured Json
  evidence   Json?
  sources    Json?

  // Adversarial verifier result (JSON)
  verification Json?

  synthesisProvider String?
  synthesisModel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([tenantId, createdAt])
  @@index([runId, version])
  @@map("research_reports")
}

model ResearchTeamProfile {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  name         String
  capabilities Json // array of capability ids / custom strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("research_team_profiles")
}

/// Which agents may take calls for which campaigns.
///
/// Added for Dialer V2. Before this the schema modelled no relation between an
/// agent and a campaign in either direction, so predictive pacing had no way to
/// know how many agents a campaign actually has. The dialer failed closed —
/// every campaign forecast counted zero agents — because the alternative, a
/// wildcard, would have put every agent in every campaign and inflated the
/// capacity number that governs how hard the dialer is allowed to dial.
///
/// Deliberately additive: nothing else in the schema reads this table, and
/// removing it restores the previous behaviour exactly.
model CampaignAgent {
  id         String              @id @default(uuid())
  tenantId   String
  campaignId String
  /// The agent. `User` IS the agent in this schema — there is no Agent model.
  userId     String
  status     CampaignAgentStatus @default(ACTIVE)
  /// Lower is preferred. Null means no preference among a campaign's agents.
  priority   Int?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per agent per campaign. A duplicate would double-count that agent
  /// in the campaign's available capacity.
  @@unique([tenantId, campaignId, userId])
  @@index([tenantId])
  @@index([campaignId])
  @@index([userId])
  /// The dialer's hot read: every active campaign for one agent.
  @@index([tenantId, userId, status])
  @@map("campaign_agents")
}

enum CampaignAgentStatus {
  ACTIVE
  INACTIVE
}

/// Destination formats carriers accept. Names describe the wire format, not a
/// country: NANP11 is `1` + 10 digits, NANP10 is bare 10 digits, E164 is `+1`
/// + 10 digits.
enum CarrierNumberFormat {
  E164
  NANP11
  NANP10
}

/// The call paths that get an independently configurable carrier waterfall.
enum CallRouteType {
  INBOUND
  CC_MANUAL
  CC_POWER_DIALER
  SOFTPHONE_MANUAL
  PREDICTIVE_DIALER
  DOGRAH_AI
}

/// One FreeSWITCH gateway. `name` must match a `<gateway name="...">` in
/// apps/freeswitch/conf/sip_profiles/external/ — it is interpolated straight
/// into `sofia/gateway/<name>/<number>`, so a typo here is a dead call.
model CarrierGateway {
  id        String  @id @default(uuid())
  tenantId  String
  carrierId String
  name      String
  priority  Int     @default(0)
  enabled   Boolean @default(true)

  /// How the destination is written for this gateway. Carriers disagree:
  /// FracTEL and BulkVS want 1XXXXXXXXXX, SignalWire wants +1XXXXXXXXXX. A
  /// fallback that dials the right carrier in the wrong format is still a
  /// dead call, so the format travels with the gateway.
  numberFormat CarrierNumberFormat @default(NANP11)

  /// Health, maintained by recordGatewayOutcome(). A gateway is skipped while
  /// `circuitOpenUntil` is in the future; `consecutiveFailures` is what opens
  /// it and any success resets both.
  consecutiveFailures Int       @default(0)
  circuitOpenUntil    DateTime?
  lastFailureAt       DateTime?
  lastFailureCause    String?
  lastSuccessAt       DateTime?
  totalAttempts       BigInt    @default(0)
  totalFailures       BigInt    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([carrierId])
  @@map("carrier_gateways")
}

/// The waterfall for one call type. Exactly one row per (tenant, callType);
/// the ordering lives in the steps.
model CarrierRoute {
  id       String        @id @default(uuid())
  tenantId String
  callType CallRouteType
  enabled  Boolean       @default(true)

  /// Per-leg dial timeout handed to FreeSWITCH. Short enough that a
  /// black-holing carrier falls through to the next one while the caller is
  /// still listening.
  legTimeoutSeconds Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  CarrierRouteStep[]

  @@unique([tenantId, callType])
  @@index([tenantId])
  @@map("carrier_routes")
}

/// One rung of the waterfall: try this carrier's gateways, then fall to the
/// next position.
model CarrierRouteStep {
  id        String  @id @default(uuid())
  routeId   String
  carrierId String
  position  Int
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route   CarrierRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  carrier Carrier      @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([routeId, carrierId])
  @@index([routeId])
  @@index([carrierId])
  @@map("carrier_route_steps")
}
