/// Which agents may take calls for which campaigns.
///
/// Added for Dialer V2. Before this the schema modelled no relation between an
/// agent and a campaign in either direction, so predictive pacing had no way to
/// know how many agents a campaign actually has. The dialer failed closed —
/// every campaign forecast counted zero agents — because the alternative, a
/// wildcard, would have put every agent in every campaign and inflated the
/// capacity number that governs how hard the dialer is allowed to dial.
///
/// Deliberately additive: nothing else in the schema reads this table, and
/// removing it restores the previous behaviour exactly.
model CampaignAgent {
  id         String              @id @default(uuid())
  tenantId   String
  campaignId String
  /// The agent. `User` IS the agent in this schema — there is no Agent model.
  userId     String
  status     CampaignAgentStatus @default(ACTIVE)
  /// Lower is preferred. Null means no preference among a campaign's agents.
  priority   Int?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per agent per campaign. A duplicate would double-count that agent
  /// in the campaign's available capacity.
  @@unique([tenantId, campaignId, userId])
  @@index([tenantId])
  @@index([campaignId])
  @@index([userId])
  /// The dialer's hot read: every active campaign for one agent.
  @@index([tenantId, userId, status])
  @@map("campaign_agents")
}

enum CampaignAgentStatus {
  ACTIVE
  INACTIVE
}

/// Destination formats carriers accept. Names describe the wire format, not a
/// country: NANP11 is `1` + 10 digits, NANP10 is bare 10 digits, E164 is `+1`
/// + 10 digits.
enum CarrierNumberFormat {
  E164
  NANP11
  NANP10
}

/// The call paths that get an independently configurable carrier waterfall.
enum CallRouteType {
  INBOUND
  CC_MANUAL
  CC_POWER_DIALER
  SOFTPHONE_MANUAL
  PREDICTIVE_DIALER
  DOGRAH_AI
}

/// One FreeSWITCH gateway. `name` must match a `<gateway name="...">` in
/// apps/freeswitch/conf/sip_profiles/external/ — it is interpolated straight
/// into `sofia/gateway/<name>/<number>`, so a typo here is a dead call.
model CarrierGateway {
  id        String  @id @default(uuid())
  tenantId  String
  carrierId String
  name      String
  priority  Int     @default(0)
  enabled   Boolean @default(true)

  /// How the destination is written for this gateway. Carriers disagree:
  /// FracTEL and BulkVS want 1XXXXXXXXXX, SignalWire wants +1XXXXXXXXXX. A
  /// fallback that dials the right carrier in the wrong format is still a
  /// dead call, so the format travels with the gateway.
  numberFormat CarrierNumberFormat @default(NANP11)

  /// Digits dialed in front of the destination to identify this trunk to the
  /// carrier — Anveo Direct calls it a tech prefix and uses it to select which
  /// outbound trunk a call belongs to, so an INVITE without it matches nothing
  /// and is refused. Prepended verbatim to the formatted number, so it composes
  /// with numberFormat: "012345" + NANP11 dials 0123451XXXXXXXXXX.
  ///
  /// Null for carriers that route on source IP alone, which is most of them.
  techPrefix String?

  /// Health, maintained by recordGatewayOutcome(). A gateway is skipped while
  /// `circuitOpenUntil` is in the future; `consecutiveFailures` is what opens
  /// it and any success resets both.
  consecutiveFailures Int       @default(0)
  circuitOpenUntil    DateTime?
  lastFailureAt       DateTime?
  lastFailureCause    String?
  lastSuccessAt       DateTime?
  totalAttempts       BigInt    @default(0)
  totalFailures       BigInt    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([carrierId])
  @@map("carrier_gateways")
}

/// The waterfall for one call type. Exactly one row per (tenant, callType);
/// the ordering lives in the steps.
model CarrierRoute {
  id       String        @id @default(uuid())
  tenantId String
  callType CallRouteType
  enabled  Boolean       @default(true)

  /// Per-leg dial timeout handed to FreeSWITCH. Short enough that a
  /// black-holing carrier falls through to the next one while the caller is
  /// still listening.
  legTimeoutSeconds Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  CarrierRouteStep[]

  @@unique([tenantId, callType])
  @@index([tenantId])
  @@map("carrier_routes")
}

/// One rung of the waterfall: try this carrier's gateways, then fall to the
/// next position.
model CarrierRouteStep {
  id        String  @id @default(uuid())
  routeId   String
  carrierId String
  position  Int
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route   CarrierRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  carrier Carrier      @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([routeId, carrierId])
  @@index([routeId])
  @@index([carrierId])
  @@map("carrier_route_steps")
}

// ============================================================================
// Platform staff
// ============================================================================

/// NetEnroll's own staff, who see and act across every agency.
///
/// ── Why this is not a role ───────────────────────────────────────────────────
///
/// `RoleName` is per-tenant by construction: a `UserRole` row grants a name
/// inside the tenant its user belongs to, and every check on OWNER or ADMIN
/// therefore means "an administrator of SOME agency". That is the right shape
/// for an agency principal and the wrong shape for NetEnroll -- gating a
/// platform-wide route on OWNER admits the principal of every agency on the
/// platform the moment the first one is given a login.
///
/// It is also deliberately not "OWNER of a special tenant". That would put the
/// capability back inside the tenant dimension, where a bug in tenant
/// resolution could confer it, and where "which tenant am I acting in" and "am
/// I allowed to act across tenants" would be the same question. They are not
/// the same question, so they are not the same row.
///
/// Holding a row here is the whole capability. There is no scope on it, no
/// tenant on it, and no level: a user either is NetEnroll staff or is not.
/// Revoking is deleting the row.
model PlatformAdmin {
  id     String @id @default(uuid())
  userId String @unique

  /// Who granted it and when, because a capability this broad should never
  /// appear in the table without a trail. `grantedBy` is a user id, or null
  /// when the row came from the provisioning command at install time.
  grantedAt DateTime @default(now())
  grantedBy String?
  note      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

/// The one agency a platform admin is currently acting inside, if any.
///
/// ── Why this is a table ──────────────────────────────────────────────────────
///
/// A platform admin's default acting tenant is NONE: they get the cross-agency
/// view, and agency-scoped routes refuse them, because "no tenant" is not a
/// wildcard. To act inside one agency they select it, and that selection has to
/// live somewhere the browser cannot reach.
///
/// Not a header, query parameter or body field: Phase 1 removed every one of
/// those as a tenant input, and re-adding one for privileged users would give
/// the most powerful accounts on the platform the weakest tenant resolution.
/// Not the Redis session either -- `middleware/session.ts` swallows its own
/// errors, so a Redis blip silently drops the selection, and a security-
/// relevant switch must not be able to fail quietly.
///
/// So: a row, written by the enter endpoint, deleted by the leave endpoint,
/// read by the authentication middleware, which copies it onto
/// `request.user.tenantId`. `lib/tenant-context.ts` is untouched and still
/// reads `request.user` and nothing else -- the selection populates the
/// principal rather than teaching the helper a second rule.
///
/// Unique on `userId`: an operator is inside one agency or none, never two.
model PlatformActingTenant {
  id       String @id @default(uuid())
  userId   String @unique
  tenantId String

  /// Paired with the `platform.tenant.entered` AuditLog row written at the same
  /// moment. The row is the state; the audit log is the history.
  enteredAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("platform_acting_tenants")
}

// ============================================================================
// Phase 2 — measurement, the rate curve, and the daily rating engine
//
// Nothing here charges anyone or gates delivery; that is Phase 3. What these
// tables hold is the arithmetic Phase 3 will bill from, and the evidence for
// it. An agency that disputes its price is shown a `rate_changes` row, so that
// row has to be complete enough to recompute the rate from itself.
//
// Money is never a refund, a credit, a reversal or a make-good. There is no
// column for one anywhere below, and a carrier's decision after submission --
// issued, declined, rescinded, lapsed -- appears nowhere in this schema,
// because it is not an input to the price.
// ============================================================================

/// Where an agency stands: how it is priced today, and why.
enum AgencyRatingStatus {
  /// RETIRED IN PHASE 3. There is no introductory rate, so nothing puts an
  /// agency into this state any more. An agency that carries it -- or that has
  /// no state row at all -- has no opening agreement recorded, which means it
  /// has no rate and is not delivered to. The member survives because removing
  /// an enum value is a destructive migration and this project's are additive.
  INTRODUCTORY

  /// An opening rate and opening block were agreed instead of the
  /// introductory package. Supersedes INTRODUCTORY; daily rating begins from
  /// the first settled day.
  OPENING_BLOCK

  /// Priced from the curve, off the trailing window.
  RATED

  /// Measured below the curve's minimum closing percentage. There is NO rate
  /// in this state -- the curve is never extrapolated below its lowest anchor.
  /// Phase 3 pauses delivery on this flag. Only a platform admin clears it.
  UNDER_REVIEW
}

/// What a day's rating run concluded.
enum RateChangeStatus {
  /// A rate was derived from the curve and applies to `effectiveBusinessDay`.
  APPLIED

  /// The window's closing percentage was below the curve's minimum. No rate;
  /// the agency is flagged for review.
  BELOW_MINIMUM

  /// The window contained no delivered calls, so there is no closing
  /// percentage to price from. The previous rate stands. Recorded rather than
  /// skipped, so a gap in the history is always a gap in the RUNS, never a day
  /// that ran and said nothing.
  NO_DATA
}

/// One published version of the rate curve.
///
/// ── Why the anchors are rows and not constants ───────────────────────────────
///
/// A change to the anchor points must never alter a rate already applied to a
/// completed settlement. Constants in code cannot promise that: the next deploy
/// silently reprices every historical row that recomputes from them. So the
/// curve is versioned data, every `rate_changes` row records which version
/// priced it, and a new version is a new row rather than an edit.
///
/// Versions are never edited in place and never deleted. `retiredAt` stops a
/// version being selected for new pricing; the rows that were priced by it
/// still resolve.
model RateCurveVersion {
  id      String @id @default(uuid())
  /// Monotonic, human-quotable ("priced on curve v1").
  version Int    @unique
  label   String?
  note    String?

  /// When this version became the one new ratings are priced from.
  effectiveFrom DateTime  @default(now())
  retiredAt     DateTime?

  /// Below this closing percentage there is NO rate: the agency is flagged for
  /// review and the curve is not extrapolated downward. Stored as a
  /// percentage, so 5.0 means 5%.
  minimumClosingPct Decimal @db.Decimal(6, 3)

  /// At and above this closing percentage the curve is FLAT at the rate of its
  /// highest anchor. Not extrapolated: 15% and 20% pay the same.
  flatFromClosingPct Decimal @db.Decimal(6, 3)

  /// RETIRED IN PHASE 3. There is no introductory rate.
  ///
  /// An agency's opening rate and opening block are agreed before its first
  /// Delivery Day and recorded per tenant (`AgencyBillingProfile` and
  /// `AgencyRatingState.openingRate`); from the second Delivery Day the rate
  /// curve governs. No code reads either column any more -- grep them.
  ///
  /// They are still here because the production database is migrated by piping
  /// SQL into psql by hand and this project's migrations are additive only:
  /// dropping a column is the one thing they must never do, since a column that
  /// turns out to have been wanted cannot be un-dropped. Phase 3's migration
  /// gives them defaults so a new curve version can be published without
  /// supplying a number nobody uses.
  introductoryRate         Decimal @default(0) @db.Decimal(10, 2)
  introductoryApplications Int     @default(0)

  createdAt   DateTime @default(now())
  createdById String?

  anchors     RateCurveAnchor[]
  rateChanges RateChange[]
  states      AgencyRatingState[]

  @@map("rate_curve_versions")
}

/// One (closing percentage, rate) point on a curve version.
///
/// The rate for any closing percentage between two anchors is their linear
/// interpolation, rounded to the nearest dollar. That is a deliberate change
/// from an earlier step-banded design and must not be simplified back: at these
/// volumes the measured closing percentage carries about +/-1.4 points of
/// sampling error at 450 calls in a window and +/-2.8 at 150, so one-point-wide
/// bands are narrower than the noise. On a step scale an agency sitting exactly
/// on a band edge pays about 4% above its fair rate purely from randomness,
/// because downward noise is expensive and upward noise is free. A continuous
/// curve makes small errors symmetric and cuts that distortion to under 2%.
model RateCurveAnchor {
  id             String @id @default(uuid())
  curveVersionId String

  /// A percentage, so 10.0 means 10%.
  closingPct Decimal @db.Decimal(6, 3)
  /// Dollars per submitted application.
  rate       Decimal @db.Decimal(10, 2)

  curveVersion RateCurveVersion @relation(fields: [curveVersionId], references: [id], onDelete: Cascade)

  @@unique([curveVersionId, closingPct])
  @@index([curveVersionId])
  @@map("rate_curve_anchors")
}

/// Operational settings for the rating engine. One row, id `global`.
///
/// Separate from `RateCurveVersion` because these are not pricing: the window
/// length is how the engine measures, the curve is what the measurement is
/// priced against. Every `rate_changes` row records the window it actually used
/// anyway, so changing this never makes a past row unreproducible.
model RatingSettings {
  id String @id @default("global")

  /// Trailing window, in DELIVERY DAYS, over which the closing percentage that
  /// sets tomorrow's rate is measured. Configurable; 3 by default.
  ///
  /// A Delivery Day is a calendar day on which NetEnroll delivered at least one
  /// call to that agency. Deliberately not calendar days: a weekday-only agency
  /// would have Monday priced off Saturday and Sunday, two empty days, and a
  /// third of its denominator would be zero for reasons unconnected to how it
  /// performs. Deliberately not Business Days either -- that term is reserved
  /// for contractual notice periods and would be wrong for an agency that does
  /// work weekends. See `services/rating/delivery-day.ts`.
  ///
  /// There is deliberately no minimum-call threshold beside it. An earlier
  /// draft required 250 delivered calls in the window to stop a thin sample
  /// falling off a band edge; with a continuous curve there are no edges, and
  /// both launch agencies clear 450 calls in a 3-day window regardless.
  windowDeliveryDays Int @default(3)

  /// How many calendar days back to search for those Delivery Days before
  /// giving up. Not a business rule -- a bound so an agency that stopped taking
  /// calls does not cause an unbounded scan. A window that runs short is
  /// recorded as short, never padded.
  deliveryDayLookback Int @default(60)

  /// The version new ratings are priced from.
  activeCurveVersionId String?

  updatedAt DateTime @updatedAt

  @@map("rating_settings")
}

/// Where one agency stands right now. Mutable; the history is `rate_changes`.
model AgencyRatingState {
  id       String @id @default(uuid())
  tenantId String @unique

  status AgencyRatingStatus @default(INTRODUCTORY)

  /// Dollars per submitted application, or null in UNDER_REVIEW -- an agency
  /// below the curve's minimum has no rate at all, which is not the same as a
  /// rate of zero and must never be rendered as one.
  currentRate    Decimal? @db.Decimal(10, 2)
  curveVersionId String?

  /// The calendar day (`YYYY-MM-DD`, America/New_York) `currentRate` applies
  /// to. A string rather than a date column so no layer between here and the
  /// browser can shift it by a timezone.
  ///
  /// A rate applies to a whole calendar day, not to a Delivery Day: an agency
  /// that takes no calls on a Sunday still has a rate on Sunday, it simply does
  /// not earn at it.
  currentRateCalendarDay String?

  /// The last closed calendar day the engine has rated. Makes a re-run a no-op
  /// rather than a second row.
  lastRatedCalendarDay String?

  /// RETIRED IN PHASE 3, with `RateCurveVersion.introductoryRate`. Nothing
  /// reads or writes it. Kept only because migrations here are additive only.
  introductoryApplicationsUsed Int @default(0)

  /// An agreed opening rate and block, which supersede the introductory
  /// package. Set by a platform admin; daily rating begins from the first
  /// settled day.
  openingRate              Decimal? @db.Decimal(10, 2)
  openingBlockApplications Int?
  openingAgreementNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curveVersion RateCurveVersion? @relation(fields: [curveVersionId], references: [id])

  @@index([status])
  @@map("agency_rating_states")
}

/// One immutable rating decision.
///
/// This is the row shown to an agency that disputes its price, so it carries
/// everything needed to recompute that price from itself: the window, the two
/// counts, the closing percentage they produce, the curve version that priced
/// it, and the rate before and after. Nothing here is derived at read time.
///
/// Never updated and never deleted. A correction is a later row, not an edit.
model RateChange {
  id       String @id @default(uuid())
  tenantId String

  /// The calendar day this rate applies to (`YYYY-MM-DD`, America/New_York) --
  /// the day AFTER the window closed.
  effectiveCalendarDay String

  /// The window the counts were taken over.
  ///
  /// The day keys are recorded verbatim as well as the instants, because a
  /// Delivery Day window is NOT contiguous: Thursday, Friday and Monday spans a
  /// weekend, so `windowStart`..`windowEndExclusive` covers five days while the
  /// counts cover three. A reader recomputing from this row must use
  /// `windowDayKeys`, and having both is what makes that unambiguous.
  windowStart        DateTime
  windowEndExclusive DateTime
  /// How many Delivery Days were asked for.
  windowDeliveryDays Int
  /// How many were found. Fewer than requested for a new agency, or one that
  /// has stopped. Recorded rather than padded -- a shorter window is a smaller
  /// sample and the row should say so.
  windowDaysFound    Int
  windowDayKeys      String[]

  /// The two counts. Delivered call: routed to this agency and answered by one
  /// of its agents. Submitted application: an InsuranceCarrierApplication for
  /// this agency that reached submitted state, counted once, attributed by
  /// submission timestamp.
  deliveredCalls         Int
  submittedApplications  Int

  /// submittedApplications / deliveredCalls, as a percentage. Null when there
  /// were no delivered calls -- never 0, which would read as "nobody closed
  /// anything" and price the agency for review.
  closingPct Decimal? @db.Decimal(9, 6)

  curveVersionId String
  /// Denormalised so the row is readable, and quotable, without a join.
  curveVersion   Int

  previousRate Decimal? @db.Decimal(10, 2)
  /// Null in BELOW_MINIMUM: there is no rate below the curve's floor.
  newRate      Decimal? @db.Decimal(10, 2)

  status     RateChangeStatus
  computedAt DateTime         @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curve       RateCurveVersion @relation(fields: [curveVersionId], references: [id])
  reviewFlags RatingReviewFlag[]

  /// One decision per agency per effective day. Makes the daily run idempotent:
  /// re-running it writes nothing rather than a second, conflicting price.
  @@unique([tenantId, effectiveCalendarDay])
  @@index([tenantId, computedAt])
  @@map("rate_changes")
}

/// An agency measured below the curve's minimum closing percentage.
///
/// Raised by the rating engine, cleared only by a platform admin. An agency
/// cannot clear its own flag -- the whole point of the state is that somebody
/// outside the agency looks at it before delivery resumes in Phase 3.
model RatingReviewFlag {
  id       String @id @default(uuid())
  tenantId String

  raisedAt     DateTime @default(now())
  rateChangeId String

  /// Copied from the rate change that raised it, so the flag reads on its own.
  closingPct            Decimal @db.Decimal(9, 6)
  deliveredCalls        Int
  submittedApplications Int

  clearedAt       DateTime?
  clearedByUserId String?
  clearedNote     String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rateChange RateChange @relation(fields: [rateChangeId], references: [id], onDelete: Cascade)

  @@index([tenantId, clearedAt])
  @@map("rating_review_flags")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 3 — the ledger, overrun, delivery gating and daily settlement
//
// Phase 2 made the numbers correct. This is what charges money against them:
// off-session ACH debits, against real bank accounts, with no refund path in
// the product. There is no reversal, credit, rebate or make-good anywhere
// below -- not a column, not an enum member, not a status.
//
// See docs/BILLING.md.
// ═══════════════════════════════════════════════════════════════════════════

/// What one row of the credit ledger records.
///
/// There is deliberately no REFUND, CREDIT, REVERSAL, ADJUSTMENT or CHARGEBACK
/// member. A carrier's decision after an application is submitted never returns
/// a credit, and the absence of the enum member is what makes that true rather
/// than a policy someone has to remember.
enum CreditLedgerEntryType {
  /// A block of application credits bought for one Delivery Day, at one rate.
  /// `quantity` is positive.
  PURCHASE

  /// One application that reached submitted state and spent one credit.
  /// `quantity` is -1, always, and the row names both the application and the
  /// purchase lot the credit came from.
  CONSUMPTION

  /// One application that reached submitted state beyond the Daily Block, with
  /// no credit left to spend. `quantity` is 0 -- an overrun does not move the
  /// balance, because there was no balance to move. It is billed that evening
  /// at the rate the settlement derives, and the settlement row for its
  /// Delivery Day is where that money is recorded.
  OVERRUN
}

/// Where a settlement's single off-session debit stands.
enum SettlementPaymentStatus {
  /// Computed, not yet submitted to Stripe.
  PENDING

  /// Computed and recorded in full, with no debit placed, because charging is
  /// not enabled for this agency (`AgencyBillingProfile.chargesEnabled`) or the
  /// run was invoked with `--no-charge`.
  ///
  /// Every figure on the row is the real computation, so this is what a
  /// settlement WOULD have charged. It is deliberately not counted as a clean
  /// settlement: nothing was paid, so it must not raise an Overrun ceiling.
  DRY_RUN
  /// Submitted and accepted. ACH settles over days; `SUCCEEDED` means Stripe
  /// reported the payment intent succeeded.
  SUCCEEDED
  /// Stripe reported a failure. Delivery holds at the current paid balance and
  /// the grace period starts.
  FAILED
  /// Nothing was charged because the computed total was zero -- no overrun, and
  /// the next day's block fully covered by unused paid applications.
  NOT_CHARGED
  /// The computed total exceeded the agency's configured maximum daily debit.
  /// Nothing was sent to Stripe. Platform admins are alerted and a human
  /// decides. This is a halt, not a retry.
  HALTED_MAX_DEBIT
  /// The agency has no valid ACH mandate, so there is nothing to debit. Nothing
  /// was sent to Stripe; delivery is already gated off for the same reason.
  HALTED_NO_MANDATE
}

/// Why an ACH mandate is or is not usable for an off-session debit.
enum AchMandateStatus {
  /// No mandate has been recorded. No delivery.
  NONE
  /// A Stripe SetupIntent exists but micro-deposit or instant verification has
  /// not completed. Not usable, so still no delivery.
  PENDING_VERIFICATION
  /// Verified and usable off-session.
  ACTIVE
  /// Stripe reported the payment method unusable, or a platform admin detached
  /// it. No delivery.
  REVOKED
}

/// Why delivery stopped. Every one of these is derived live by the delivery
/// gate; the rows exist so the agency can be told which, so platform admins are
/// notified once rather than once per call, and so the portal can say when.
enum DeliveryHoldReason {
  /// The Overrun ceiling for the Delivery Day was reached. Delivery resumes on
  /// the next Delivery Day; a call already connected finishes normally.
  CEILING_REACHED
  /// The trailing-window closing percentage fell below the curve's minimum.
  /// Only a platform admin clears this; the next day's numbers cannot.
  BELOW_MINIMUM_CLOSING
  /// A settlement is unpaid past its grace period, or unpaid at all.
  SETTLEMENT_UNPAID
  /// No valid ACH mandate.
  NO_MANDATE
  /// A platform admin suspended the account.
  ADMIN_SUSPENDED
  /// No opening rate and opening block have been agreed and recorded, so there
  /// is no price and nothing has been bought.
  NO_OPENING_AGREEMENT
}

/// Who a billing notification was for, and what it was about.
enum BillingNotificationKind {
  SETTLEMENT_FAILED
  SETTLEMENT_UNPAID_GRACE_EXPIRED
  MAX_DAILY_DEBIT_EXCEEDED
  CEILING_REACHED
  DELIVERY_PAUSED
  MANDATE_MISSING
  SETTLEMENT_RUN_FAILED
}

/// One agency's commercial terms and payment instrument.
///
/// Everything here is set by a platform admin or written by the server from a
/// verified Stripe object. No figure on this row can be set from an agency's
/// browser, because every one of them bounds what the agency can be charged.
model AgencyBillingProfile {
  id       String @id @default(uuid())
  tenantId String @unique

  /// ── The enrolment switch ──────────────────────────────────────────────────
  ///
  /// Whether this agency is subject to the billing system AT ALL. Set when a
  /// platform admin explicitly enrols the agency, and null otherwise.
  ///
  /// A tenant that is not enrolled is not gated, not metered and not settled:
  /// its calls deliver exactly as they did before Phase 3 existed, no ledger
  /// row is written when one of its applications reaches submitted state, and
  /// the nightly settlement skips it rather than settling it at zero.
  ///
  /// It is deliberately NOT inferred from anything. Not from the existence of
  /// this row, not from a mandate, not from ledger rows. Phase 3 shipped
  /// inferring it -- a tenant with no billing profile got `hasValidMandate:
  /// false` and was refused with NO_MANDATE -- which would have stopped call
  /// delivery for every agency on the platform the moment it deployed,
  /// including one carrying live client traffic. An opt-in that can be arrived
  /// at accidentally is not an opt-in.
  ///
  /// The default is unenrolled, and the migration enrols nobody.
  billingEnrolledAt       DateTime?
  billingEnrolledByUserId String?
  billingEnrolmentNote    String?

  /// ── The charging switch ───────────────────────────────────────────────────
  ///
  /// Whether a settlement for this agency may actually place a debit.
  ///
  /// False by default, so enrolling an agency puts it in a state where the
  /// settlement computes everything and records the full immutable settlement
  /// row, and only the Stripe charge is skipped -- `paymentStatus: DRY_RUN`.
  /// Real money needs a second, separate, explicit act.
  ///
  /// This is the switch to watch an agency's settlements compute correctly for
  /// several days before anything reaches a bank account.
  chargesEnabled         Boolean   @default(false)
  chargesEnabledAt       DateTime?
  chargesEnabledByUserId String?

  /// The agency's configured daily target quantity: how many application
  /// credits the nightly settlement sells for the next Delivery Day. Reduced or
  /// omitted where unused paid applications remain.
  dailyBlockApplications Int @default(0)

  /// The maximum a single Delivery Day's debit may reach, in dollars. This is a
  /// contractual commitment on the Insertion Order -- Daily Block plus Overrun
  /// ceiling at the applicable rate -- not a guideline. A computed settlement
  /// above it is not charged at all: it halts and alerts.
  maxDailyDebit Decimal @db.Decimal(12, 2)

  /// The Overrun ceiling, as a percentage above the Daily Block.
  ///
  /// 50% for an agency with fewer than `ceilingCleanSettlementThreshold`
  /// consecutive settlements free of failed or unpaid debits, 100% at or beyond
  /// it. Both configurable here, per tenant.
  ceilingPctBelowThreshold        Decimal @default(50) @db.Decimal(6, 2)
  ceilingPctAtThreshold           Decimal @default(100) @db.Decimal(6, 2)
  ceilingCleanSettlementThreshold Int     @default(10)

  /// A platform admin's override of the ceiling for this agency, as a
  /// percentage above the Daily Block. Overrun is credit extended at
  /// NetEnroll's discretion, so it can be reduced or withdrawn at any time:
  /// 0 withdraws it entirely, and null means "use the schedule above".
  ceilingPctOverride      Decimal?  @db.Decimal(6, 2)
  ceilingOverrideByUserId String?
  ceilingOverrideNote     String?
  ceilingOverrideAt       DateTime?

  /// Stripe. The customer is created once; the mandate is a us_bank_account
  /// payment method saved against it, and its id is written here only after the
  /// server has retrieved it from Stripe. A browser never asserts either.
  stripeCustomerId     String?
  achPaymentMethodId   String?
  achMandateStatus     AchMandateStatus @default(NONE)
  achMandateVerifiedAt DateTime?
  achBankName          String?
  achLast4             String?

  /// A platform admin suspension. Paused is not terminated: paid applications
  /// survive untouched and are available when delivery resumes.
  suspendedAt       DateTime?
  suspendedByUserId String?
  suspensionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The settlement run walks tenants and skips the unenrolled, so enrolment is
  /// the only column read as a set.
  @@index([billingEnrolledAt])
  @@map("agency_billing_profiles")
}

/// The credit ledger. Append-only, per tenant, and the only source of a balance.
///
/// ── Balance is derived, never stored ─────────────────────────────────────────
///
/// `balance = SUM(quantity)` for the tenant. There is no counter column here or
/// anywhere else, because a counter is wrong the first time a write is retried
/// and it gates whether a call is delivered.
///
/// ── Two rows can never spend the same credit ─────────────────────────────────
///
/// A consumption claims a specific unit of a specific purchase lot:
/// `(purchaseEntryId, lotIndex)` is unique. Two applications reaching submitted
/// state at the same instant both compute the same next free index; the
/// database admits one and rejects the other, which retries onto the next unit.
/// That is a constraint, not a check-then-act, and it is what the concurrency
/// test asserts.
///
/// ── An application spends at most one credit, ever ───────────────────────────
///
/// `applicationId` is unique across the whole table, so an application that
/// reaches submitted state twice -- a retried automation run, a replayed
/// completion -- has one row: either the credit it spent or the overrun it was
/// recorded as, never both and never two.
///
/// ── Nothing here is ever updated or deleted ──────────────────────────────────
///
/// Enforced by a database trigger (see the migration), not by convention. A
/// correction is a later row.
model ApplicationCreditLedgerEntry {
  id        String                @id @default(uuid())
  tenantId  String
  entryType CreditLedgerEntryType

  /// +N for a purchase, -1 for a consumption, 0 for an overrun. Summing this
  /// column for a tenant is the balance, and is the only way to get one.
  quantity Int

  /// The Delivery Day this row belongs to (`YYYY-MM-DD`, America/New_York).
  /// For a purchase, the day the block was bought FOR. For a consumption or an
  /// overrun, the day the application was submitted on.
  deliveryDay String

  /// Dollars per application.
  ///
  /// On a purchase, the price actually paid. On a consumption, copied from the
  /// purchase lot the credit came from, so the row values itself without a
  /// join. Null on an overrun, and only on an overrun: an overrun is priced
  /// that evening at the rate the settlement derives, and the settlement row
  /// for its Delivery Day carries that rate, the quantity and the amount.
  unitRate Decimal? @db.Decimal(10, 2)

  /// quantity * unitRate for a purchase, so the row reconstructs its own value.
  amount Decimal? @db.Decimal(12, 2)

  /// The curve version that priced a purchase, denormalised so the row is
  /// readable without a join and still correct after a new version is published.
  curveVersionId String?
  curveVersion   Int?

  /// The application this row is about. Set on CONSUMPTION and OVERRUN, null on
  /// PURCHASE. Unique across the table.
  applicationId String?

  /// CONSUMPTION only: the purchase lot the credit came from, and which unit of
  /// it. Oldest lot first, so credits spanning purchases at different rates are
  /// consumed in the order they were bought.
  purchaseEntryId String?
  lotIndex        Int?

  /// PURCHASE only. The Stripe payment reference the block was bought with, and
  /// the settlement that sold it. The opening purchase has a payment reference
  /// and no settlement.
  stripePaymentIntentId String?
  settlementId          String?

  createdAt DateTime @default(now())

  tenant       Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase     ApplicationCreditLedgerEntry?  @relation("CreditLot", fields: [purchaseEntryId], references: [id])
  consumptions ApplicationCreditLedgerEntry[] @relation("CreditLot")
  settlement   DailySettlement?               @relation(fields: [settlementId], references: [id])

  /// One row per application, whatever its type. This is what makes an
  /// application that reaches submitted state twice cost exactly one credit.
  @@unique([applicationId])
  /// One consumption per unit of a purchase lot. This is what makes two
  /// simultaneous consumptions spend two different credits.
  @@unique([purchaseEntryId, lotIndex])
  @@index([tenantId, createdAt])
  @@index([tenantId, entryType, createdAt])
  @@index([tenantId, deliveryDay])
  @@index([settlementId])
  @@map("application_credit_ledger")
}

/// One Delivery Day's settlement for one agency. Immutable.
///
/// Every figure that prices the day is written once, inside the transaction
/// that writes the row, and a database trigger refuses any update that would
/// change one. The only fields that advance afterwards are the payment
/// lifecycle, and every transition of those is also appended to
/// `settlement_payment_attempts`, so the history reads from rows rather than
/// from a log.
///
/// `(tenantId, deliveryDay)` is unique. That is the idempotency, and it is a
/// constraint rather than a check-then-act: running the job twice for the same
/// tenant and day cannot double charge, cannot sell a second block, and cannot
/// re-apply a rate, because the second insert fails.
model DailySettlement {
  id          String @id @default(uuid())
  tenantId    String
  /// The Delivery Day that closed (`YYYY-MM-DD`, America/New_York).
  deliveryDay String

  /// Step 1: the day's counts.
  deliveredCalls        Int
  submittedApplications Int

  /// Step 2: the trailing window and the rate the curve returned for it. The
  /// same rate applies to the next Delivery Day and prices tonight's overrun.
  windowClosingPct   Decimal? @db.Decimal(9, 6)
  windowDeliveryDays Int
  windowDaysFound    Int
  windowDayKeys      String[]
  rate               Decimal? @db.Decimal(10, 2)
  curveVersionId     String?
  curveVersion       Int?
  /// The `rate_changes` row this settlement priced from, so the two records
  /// point at each other and a dispute resolves against one chain.
  rateChangeId       String?

  /// Step 3: today's overrun, billed at that rate.
  overrunQuantity Int     @default(0)
  overrunAmount   Decimal @default(0) @db.Decimal(12, 2)

  /// Step 4: the next Delivery Day's block, at that rate, in the agency's
  /// configured daily target quantity, reduced by whatever paid applications
  /// remain unused.
  configuredBlockQuantity Int     @default(0)
  unusedPaidApplications  Int     @default(0)
  nextBlockQuantity       Int     @default(0)
  nextBlockAmount         Decimal @default(0) @db.Decimal(12, 2)

  /// Step 5: the single off-session debit.
  totalCharged  Decimal @default(0) @db.Decimal(12, 2)
  /// The agency's configured maximum daily debit as it stood tonight, copied so
  /// the halt decision is reconstructable from this row alone.
  maxDailyDebit Decimal @db.Decimal(12, 2)

  paymentStatus         SettlementPaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  paymentFailureCode    String?
  paymentFailureMessage String?
  paidAt                DateTime?

  /// The last Business Day -- weekdays excluding US federal holidays, not
  /// Delivery Days -- on which an unpaid settlement may still be paid before
  /// delivery stops entirely. Five Business Days from the first failure.
  gracePeriodEndsOn String?

  computedAt DateTime @default(now())

  tenant    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases ApplicationCreditLedgerEntry[]
  attempts  SettlementPaymentAttempt[]

  /// The idempotency constraint. One settlement per agency per Delivery Day.
  @@unique([tenantId, deliveryDay])
  @@index([tenantId, deliveryDay])
  @@index([paymentStatus])
  @@map("daily_settlements")
}

/// One attempt at a settlement's debit. Append-only.
///
/// ACH retries are scheduled on Stripe's own timetable rather than on one of
/// ours, so what matters here is that every attempt and every outcome is a row:
/// the settlement's current payment status is the latest of these, and an
/// agency disputing a charge is answered from the attempts, not from a log line.
model SettlementPaymentAttempt {
  id            String @id @default(uuid())
  settlementId  String
  /// 1 for the first attempt, then 2, 3 ... for each retry.
  attemptNumber Int

  status                SettlementPaymentStatus
  amount                Decimal                 @db.Decimal(12, 2)
  stripePaymentIntentId String?
  failureCode           String?
  failureMessage        String?
  occurredAt            DateTime                @default(now())

  settlement DailySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, attemptNumber])
  @@index([settlementId])
  @@map("settlement_payment_attempts")
}

/// A recorded transition of the delivery gate. Append-only.
///
/// The gate itself is derived live on every delivery decision -- a stored flag
/// would be stale the moment a settlement failed or a credit was spent. These
/// rows exist so the agency portal can say WHEN delivery stopped and why, and
/// so platform admins are notified once per Delivery Day per reason rather than
/// once per refused call.
model DeliveryHoldEvent {
  id          String             @id @default(uuid())
  tenantId    String
  deliveryDay String
  reason      DeliveryHoldReason

  detail     Json?
  occurredAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One row per agency per Delivery Day per reason. Also the notification
  /// de-duplication: the insert either wins and sends, or loses and does not.
  @@unique([tenantId, deliveryDay, reason])
  @@index([tenantId, occurredAt])
  @@map("delivery_hold_events")
}

/// A notification that was sent, or that we tried to send. Append-only.
///
/// The row is the record. Email and Slack are best-effort transports on top of
/// it, so "the agency and platform admins were notified" is answerable from the
/// database even when a transport was down.
model BillingNotification {
  id       String                  @id @default(uuid())
  tenantId String
  kind     BillingNotificationKind

  /// Who it was addressed to: the agency, NetEnroll platform staff, or both.
  toAgency   Boolean @default(false)
  toPlatform Boolean @default(false)

  subject String
  body    String
  detail  Json?

  /// Which transports actually accepted it. Empty means the row is the only
  /// record, which is still a record.
  sentVia String[]

  /// What this is about, so a repeat for the same event is not sent twice.
  subjectKey String

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, subjectKey])
  @@index([tenantId, createdAt])
  @@map("billing_notifications")
}
