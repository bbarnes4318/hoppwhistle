  payrollPayout PayrollPayout? @relation(fields: [payrollPayoutId], references: [id])

  @@index([userId, date])
  @@index([payrollPayoutId])
  @@map("time_entries")
}

/// UserFinancials stores encrypted banking data and pay rates
/// Uses AES-256-GCM encryption for sensitive banking information
model UserFinancials {
  id                  String   @id @default(uuid())
  userId              String   @unique
  payRate             Decimal  @default(0) @db.Decimal(10, 2)
  encryptedData       String?  @db.Text // AES-256-GCM encrypted banking JSON
