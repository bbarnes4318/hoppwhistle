  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([userId])
  @@index([status])
  @@map("payroll_payouts")
}

enum PayrollPayoutStatus {
  PROCESSING
  PAID
  CANCELLED
