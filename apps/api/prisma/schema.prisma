  willReplaceExisting    Boolean @default(false)
  existingCompanyName    String?
  existingPolicyNumber   String?
  existingCoverageAmount String?

  // Doctor
  doctorName    String?
  doctorAddress String?
  doctorPhone   String?

  // Health questions
  healthQ1    Boolean @default(false)
  healthQ2    Boolean @default(false)
  healthQ3    Boolean @default(false)
  healthQ4    Boolean @default(false)
  healthQ5    Boolean @default(false)
  healthQ6    Boolean @default(false)
  healthQ7a   Boolean @default(false)
  healthQ7b   Boolean @default(false)
  healthQ7c   Boolean @default(false)
  healthQ7d   Boolean @default(false)
  healthQ8a   Boolean @default(false)
  healthQ8b   Boolean @default(false)
  healthQ8c   Boolean @default(false)
