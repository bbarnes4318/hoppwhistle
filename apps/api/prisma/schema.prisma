  entries DncListEntry[]

  @@index([tenantId])
  @@index([type])
  @@map("dnc_lists")
}

enum DncListType {
  GLOBAL
  CAMPAIGN
  CUSTOM
}

enum DncListStatus {
  ACTIVE
  INACTIVE
}

model DncListEntry {
  id          String   @id @default(uuid())
  dncListId   String
  phoneNumber String // E.164 format
  reason      String?
  source      String?
  createdAt   DateTime @default(now())

