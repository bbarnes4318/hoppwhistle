# ============================================================================
# Hopwhistle Web - Environment Variables
# ============================================================================
# Copy this file to apps/web/.env.local and customize for your environment
# Note: Next.js requires NEXT_PUBLIC_ prefix for client-side variables

# ============================================================================
# Next.js Configuration
# ============================================================================
NODE_ENV=development

# ============================================================================
# API Configuration (Public - exposed to browser)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_API_KEY=demo-key
NEXT_PUBLIC_SIP_DOMAIN=
NEXT_PUBLIC_IP=

# ============================================================================
# Application Branding (Public)
# ============================================================================
NEXT_PUBLIC_APP_NAME=Hopwhistle

# ============================================================================
# Google Sign-In (Public)
# ============================================================================
# OAuth 2.0 Web client ID from the Google Cloud console. Public by design (the
# browser sends it to Google), but environment-specific, so it is configured
# rather than hardcoded. Leave it unset to hide the Google buttons entirely.
# The origin serving this app must be listed under the client's
# "Authorized JavaScript origins" or Google refuses to render the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
