<include>
  <!--
    Vapi Outbound Signed — Per-Carrier Routing with STIR/SHAKEN
    ============================================================
    RULE: Each carrier signs ONLY its own calls.
    - BulkVS:     bulkvs_shaken.lua → sofia/gateway/bulkvs
    - DIDCentral: local_shaken.lua  → sofia/gateway/didcentral
    - FracTEL:    local_shaken.lua  → sofia/gateway/fractel*
    - SignalWire:  NO signing, NO FreeSWITCH — Vapi → SignalWire direct
  -->
  <context name="vapi_outbound">

    <!-- CARRIER: BulkVS (default) -->
    <extension name="vapi-outbound-us">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="log" data="INFO [VAPI] BulkVS signed outbound to 1$1"/>
        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <!-- BulkVS signs its own calls -->
        <action application="lua" data="bulkvs_shaken.lua"/>
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC,call_timeout=60,originate_timeout=60}sofia/gateway/bulkvs/1$1"/>
      </condition>
    </extension>

    <!-- Routing IDs -->
    <extension name="vapi-outbound-routing-id">
      <condition field="destination_number" expression="^(\d{11,})$">
        <action application="log" data="INFO [VAPI] Routing ID to $1"/>
        <action application="set" data="accountcode=vapi"/>
        <action application="set" data="progress_timeout=30"/>
        <action application="set" data="originate_timeout=60"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="lua" data="bulkvs_shaken.lua"/>
        <action application="bridge" data="{sip_cid_type=pid,origination_caller_id_name=PVN LLC,call_timeout=60,originate_timeout=60}sofia/gateway/bulkvs/$1"/>
      </condition>
    </extension>

    <!-- Fallback -->
    <extension name="vapi-unmatched">
      <condition field="destination_number" expression="^.*$">
        <action application="log" data="WARNING [VAPI] Unmatched: ${destination_number}"/>
        <action application="hangup" data="NO_ROUTE_DESTINATION"/>
      </condition>
    </extension>

  </context>
</include>
