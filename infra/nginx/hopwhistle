# hopwhistle.com -- the retired browser host, kept alive on purpose.
#
# The portal now lives on agents.netenroll.com (see the sibling file in this
# directory). This block is what stops the move from breaking three things at
# once, and it does that by redirecting people while continuing to serve
# machines:
#
#   * Browsers  -- bookmarks, an open tab, a link in someone's email -- are
#     redirected to the same path on agents.netenroll.com. Sessions survive the
#     hop because the portal authenticates with a bearer token the browser
#     replays, not a cookie scoped to the old host.
#
#   * Carriers are NOT redirected. Anveo and the other providers hold webhook
#     URLs on this hostname against numbers already provisioned, and they POST
#     to them. A 301 on a POST is a dropped body: most clients re-issue it as a
#     GET and the payload is simply gone. So /api keeps proxying here, on this
#     name, for as long as any carrier still points at it.
#
#   * Softphones are NOT redirected either. /ws keeps proxying, because a
#     WebSocket cannot follow a 301 and a browser still on an old tab would
#     drop its SIP registration mid-shift.
#
# Retiring this file means, in order: repoint every carrier webhook, confirm no
# agent is registered through it, then delete it. Not before.

server {
    listen 80;
    server_name hopwhistle.com www.hopwhistle.com;
    return 301 https://$server_name$request_uri;
    location /ws {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Sec-WebSocket-Protocol sip;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    server_name hopwhistle.com www.hopwhistle.com;

    ssl_certificate /etc/letsencrypt/live/hopwhistle.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hopwhistle.com/privkey.pem;

    # Resonate standalone page
    location = /resonate {
        proxy_pass http://127.0.0.1:3000/resonate.html;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API
    location /api {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket for SIP (FreeSWITCH Verto)
    location /ws {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Sec-WebSocket-Protocol sip;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }

    # Everything a person reads moves to the new host, path intact, so a
    # bookmarked /delivery/settlements lands on the same page.
    #
    # 302, not 301: a 301 is cached by the browser forever, and if this ever has
    # to be reversed there is no way to reach the people holding the cached copy.
    # Only make it permanent once the old host is genuinely being decommissioned.
    #
    # `location /` is the shortest possible prefix, so nginx reaches it only
    # when nothing more specific matches. /api, /ws and /resonate above are all
    # longer, all match first, and none of them are redirected -- which is what
    # keeps carriers and registered softphones working on this name. Do not fold
    # this into a server-level `return`: that fires before location matching and
    # would take /api and /ws with it.
    location / {
        return 302 https://agents.netenroll.com$request_uri;
    }
}
